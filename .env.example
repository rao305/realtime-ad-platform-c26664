# Shared local defaults — copy to .env for Compose overrides.
POSTGRES_USER=ads
POSTGRES_PASSWORD=ads
POSTGRES_DB=ads
POSTGRES_DSN=postgres://ads:ads@postgres:5432/ads?sslmode=disable

REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=ad-events
KAFKA_DLQ_TOPIC=ad-events-dlq

ADSERVER_ADDR=:8080
DECISION_BUDGET_MS=30
FREQ_CAP_PER_HOUR=5

ANALYTICS_SINK=postgres
# Set ANALYTICS_SINK=bigquery and provide ADC / GOOGLE_APPLICATION_CREDENTIALS
# to use the optional BigQuery adapter.
BQ_TABLE=adplatform.analytics.events
